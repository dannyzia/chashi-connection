{
  "appId": "com.chashi.connection",
  "appName": "চাষী কানেকশন",
  "webDir": "build",
  "bundledWebRuntime": false,
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#4CAF50",
      "androidScaleType": "CENTER_CROP"
    },
    "Camera": {
      "permissions": ["camera", "photos"]
    },
    "Geolocation": {
      "permissions": ["location"]
    },
    "Storage": {
      "permissions": ["storage"]
    },
    "Network": {
      "permissions": ["network"]
    }
  }
}
